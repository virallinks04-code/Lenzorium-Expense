<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google cloud backup (encrypted) and phone-to-phone transfer of the ledger,
     settings and receipt photos. Temporary files are never included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="receipts/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="receipts/" />
    </device-transfer>
</data-extraction-rules>
