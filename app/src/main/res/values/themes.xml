<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lenzorium" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <!-- Branded launch screen shown while the app starts. -->
    <style name="Theme.Lenzorium.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Lenzorium</item>
    </style>
</resources>
